{
  "name": "aura-campus-backend",
  "version": "2.0.0",
  "description": "Privacy-first mental wellness platform backend with federated learning",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedData.js",
    "train": "node scripts/federatedTraining.js",
    "test": "jest",
    "docker:build": "docker build -t aura-campus-backend -f docker/Dockerfile .",
    "docker:up": "docker-compose -f docker/docker-compose.yml up",
    "privacy:audit": "node scripts/privacyAudit.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "socket.io": "^4.7.2",
    "ioredis": "^5.3.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.10.0",
    "crypto": "^1.0.1",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "mental-health",
    "privacy",
    "federated-learning",
    "differential-privacy",
    "anonymous",
    "wellness"
  ],
  "author": "AuraCampus Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/aura-campus-backend"
  }
}